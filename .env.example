APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Coolify: server-only service account credentials; never NEXT_PUBLIC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS pointing at a mounted secret.

# Random server-only cleanup credential, at least 32 characters.
INTERNAL_JOB_TOKEN=

# Gateway is disabled until region, model access and billing are verified.
BEDROCK_ENABLED=false
BEDROCK_MODELS_JSON=[]
# Integer microcredits; operator chooses the conversion to money.
BEDROCK_DAILY_MICROCREDIT_CAP=
# AWS SDK default credential chain: mounted credentials / role preferred.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
